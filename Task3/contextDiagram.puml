@startuml PropDevelopment_Smart_Home_Context_Simplified
!include <C4/C4_Context>

title Упрощенная контекстная диаграмма\nВнедрение сервисов "Умный дом"

' ==== КЛЮЧЕВЫЕ СТЕЙКХОЛДЕРЫ ====
Person(owner, "Собственник", "Основной пользователь\nуправляет доступом")
Person(resident, "Жилец", "Вторичный пользователь\nиспользует сервисы")
Person(guest, "Гость", "Временный пользователь\nполучает доступ")

' ==== ОСНОВНАЯ СИСТЕМА ====
System(propdev_app, "Мобильное приложение\nPropDevelopment", "Единое приложение\nдля всех сервисов")

System(propdev_backend, "Бэкенд-системы\nPropDevelopment", "Существующие CRM\nи сервисы ЖКУ")

' ==== НОВЫЕ КОМПОНЕНТЫ ====
System(smart_home_system, "Система Умный дом", "Новые бизнес-функции:\n• Интеллектуальный домофон\n• Интеллектуальный шлагбаум")

' ==== ВНЕШНИЕ СИСТЕМЫ ====
System_Ext(partner_platform, "Платформа партнера", "Внешний провайдер\nсервисов Умный дом")
System_Ext(biometric_api, "Биометрический API", "Распознавание лиц")
System_Ext(anpr_api, "ANPR API", "Распознавание\nномеров авто")

' ==== ФИЗИЧЕСКИЕ УСТРОЙСТВА ====
System_Ext(smart_doorphone, "Умный домофон", "Физическое устройство\nс камерой и СКУД")
System_Ext(smart_barrier, "Умный шлагбаум", "Физическое устройство\nс камерой ANPR")

' ==== ОСНОВНЫЕ ПОТОКИ ====

' 1. ПОЛЬЗОВАТЕЛЬСКИЕ ПОТОКИ
Rel(owner, propdev_app, "1. Настраивает доступ\n2. Управляет устройствами", "Приложение")
Rel(resident, propdev_app, "1. Использует сервисы\n2. Получает доступ", "Приложение")
Rel(guest, propdev_app, "1. Получает временный\n   доступ по приглашению", "Приложение")

' 2. ВНУТРЕННИЕ ПОТОКИ
Rel(propdev_app, propdev_backend, "Аутентификация\nи данные пользователя", "Secure API")
Rel(propdev_app, smart_home_system, "Управление\nустройствами", "Secure API")

' 3. ИНТЕГРАЦИОННЫЕ ПОТОКИ
Rel(smart_home_system, partner_platform, "Оркестрация\nустройств", "mTLS + JWT")
Rel(partner_platform, biometric_api, "Распознавание\nлиц для доступа", "gRPC/TLS")
Rel(partner_platform, anpr_api, "Распознавание\nномеров для въезда", "gRPC/TLS")

' 4. УПРАВЛЕНИЕ УСТРОЙСТВАМИ
Rel(partner_platform, smart_doorphone, "Управление доступом\nи мониторинг", "MQTT/TLS")
Rel(partner_platform, smart_barrier, "Управление шлагбаумом\nи распознавание", "MQTT/TLS")

' 5. ОБРАТНЫЕ СВЯЗИ
Rel(smart_doorphone, partner_platform, "События доступа\nи видео поток", "MQTT/TLS")
Rel(smart_barrier, partner_platform, "События проезда\nи фото номера", "MQTT/TLS")

' ==== БИЗНЕС-ЦЕННОСТЬ ====

note top of propdev_app
    <b>Бизнес-ценность для клиентов:</b>
    • Повышенная безопасность жилья
    • Удобный контроль доступа
    • Современные технологии
    • Интеграция в единое приложение
endnote

note right of smart_home_system
    <b>Технические преимущества:</b>
    • Единая точка интеграции
    • Масштабируемость
    • Безопасная архитектура
    • Поддержка новых устройств
endnote

' ==== ТРЕБОВАНИЯ ====

note bottom of partner_platform
    <b>Ключевые требования к интеграции:</b>
    1. Безопасность: Шифрование, аутентификация, аудит
    2. Надежность: 99.9% доступность, отказоустойчивость
    3. Производительность: <500мс отклик для критичных операций
    4. Соответствие: 152-ФЗ, требованиям к биометрии
endnote

@enduml